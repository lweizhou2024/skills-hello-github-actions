function [corners,info] = extractTangCorners(stlData,angleDeg)
%EXTRACTTANGCORNERS Extract 8 corners from two rectangular tang end faces.
%
% [corners,info] = extractTangCorners(stlData)
% [corners,info] = extractTangCorners(stlData,angleDeg)
%
% stlData:
%   Output from MATLAB's built-in stlread.
%
% angleDeg:
%   Permitted variation between end-face triangle normals.
%   Default = 8 degrees.
%
% corners order:
%
% Higher-z end:
%   1  larger x, larger y
%   2  larger x, smaller y
%   3  smaller x, larger y
%   4  smaller x, smaller y
%
% Lower-z end:
%   5  larger x, larger y
%   6  larger x, smaller y
%   7  smaller x, larger y
%   8  smaller x, smaller y

    %% Read mesh data

    [V,F] = getMeshArrays(stlData);

    V = double(V);
    F = double(F);

    if size(V,2) ~= 3 || size(F,2) ~= 3
        error('Vertices and faces must each have three columns.');
    end

    if nargin < 2 || isempty(angleDeg)
        angleDeg = 8;
    end

    modelRange = max(V,[],1)-min(V,[],1);
    modelSize = norm(modelRange);

    if modelSize <= 0
        error('The STL model has zero size.');
    end

    coordinateTolerance = max(1e-12,1e-8*modelSize);

    %% Remove degenerate triangles and calculate normals

    edge1 = V(F(:,2),:)-V(F(:,1),:);
    edge2 = V(F(:,3),:)-V(F(:,1),:);

    normalVector = cross(edge1,edge2,2);

    normalMagnitude = sqrt(sum(normalVector.^2,2));

    goodTriangle = ...
        normalMagnitude > max(coordinateTolerance^2,eps);

    F = F(goodTriangle,:);
    normalVector = normalVector(goodTriangle,:);
    normalMagnitude = normalMagnitude(goodTriangle);

    N = normalVector./normalMagnitude(:,[1 1 1]);

    %% Find triangles that share edges

    neighbors = triangleNeighbors(F);

    %% Extract the two end caps

    [highCorners,highInfo] = growEndCap( ...
        V,F,N,neighbors,+1, ...
        coordinateTolerance,modelSize,angleDeg);

    [lowCorners,lowInfo] = growEndCap( ...
        V,F,N,neighbors,-1, ...
        coordinateTolerance,modelSize,angleDeg);

    %% Put corners in requested order

    highCorners = orderXY(highCorners);
    lowCorners = orderXY(lowCorners);

    corners = [
        highCorners
        lowCorners];

    %% Diagnostic results

    info.highEnd = highInfo;
    info.lowEnd = lowInfo;
    info.angleDeg = angleDeg;
end


function [cornerPoints,endInfo] = growEndCap( ...
    V,F,N,neighbors,zSign,coordinateTolerance,modelSize,angleDeg)
% Start at the global z extremity and grow the connected end cap.

    %% Find vertices at the selected z extremity

    if zSign > 0

        zExtreme = max(V(:,3));

        extremeVertexIDs = find( ...
            V(:,3) >= zExtreme-5*coordinateTolerance);

    else

        zExtreme = min(V(:,3));

        extremeVertexIDs = find( ...
            V(:,3) <= zExtreme+5*coordinateTolerance);
    end

    %% Find triangles touching the extreme vertices

    touchingTriangles = find( ...
        any(ismember(F,extremeVertexIDs),2));

    if isempty(touchingTriangles)
        error('No triangle was found at one z extremity.');
    end

    %% Choose the most z-facing triangle as the seed

    [largestNormalZ,index] = ...
        max(abs(N(touchingTriangles,3)));

    seedTriangle = touchingTriangles(index);

    if largestNormalZ < 0.10

        error(['The tang end appears nearly parallel to the ', ...
               'z stacking axis.']);
    end

    referenceNormal = N(seedTriangle,:);
    referencePoint = V(F(seedTriangle,1),:);

    %% Grow connected triangles belonging to the same end face

    cosineLimit = cos(angleDeg*pi/180);

    planeTolerance = max( ...
        50*coordinateTolerance, ...
        1e-4*modelSize);

    usedTriangle = false(size(F,1),1);
    usedTriangle(seedTriangle) = true;

    triangleQueue = seedTriangle;
    queuePosition = 1;

    while queuePosition <= numel(triangleQueue)

        currentTriangle = ...
            triangleQueue(queuePosition);

        queuePosition = queuePosition+1;

        adjacentTriangles = ...
            neighbors{currentTriangle};

        for j = 1:numel(adjacentTriangles)

            candidateTriangle = ...
                adjacentTriangles(j);

            if usedTriangle(candidateTriangle)
                continue
            end

            normalOK = abs(dot( ...
                N(candidateTriangle,:), ...
                referenceNormal)) >= cosineLimit;

            candidatePoints = ...
                V(F(candidateTriangle,:),:);

            planeDistance = abs( ...
                (candidatePoints-referencePoint)* ...
                referenceNormal');

            planeOK = ...
                max(planeDistance) <= planeTolerance;

            if normalOK && planeOK

                usedTriangle(candidateTriangle) = true;

                triangleQueue(end+1) = ...
                    candidateTriangle; %#ok<AGROW>
            end
        end
    end

    %% Get all points on the detected end face

    endTriangleIDs = find(usedTriangle);

    endVertexIDs = unique(F(endTriangleIDs,:));

    endPoints = V(endVertexIDs,:);

    if size(endPoints,1) < 4
        error('The detected end face contains fewer than four vertices.');
    end

    %% Project the end face onto a best-fit plane

    faceCenter = mean(endPoints,1);

    centeredPoints = endPoints-faceCenter;

    [~,~,planeBasis] = svd(centeredPoints,0);

    coordinates2D = ...
        centeredPoints*planeBasis(:,1:2);

    %% Calculate the outer boundary

    hullIndices = convhull( ...
        coordinates2D(:,1), ...
        coordinates2D(:,2));

    hullIndices(end) = [];

    %% Fit a rectangle and select the four actual corner vertices

    [cornerPoints,rectangleInfo] = ...
        fitRectangleCorners( ...
        endPoints,coordinates2D,hullIndices);

    %% Diagnostic results

    endInfo.seedTriangle = seedTriangle;
    endInfo.triangleIDs = endTriangleIDs;
    endInfo.vertexIDs = endVertexIDs;
    endInfo.vertices = endPoints;
    endInfo.referenceNormal = referenceNormal;
    endInfo.zExtreme = zExtreme;
    endInfo.coordinates2D = coordinates2D;
    endInfo.hullIndices = hullIndices;
    endInfo.rectangle = rectangleInfo;
end


function [cornerPoints,rectangleInfo] = ...
    fitRectangleCorners(points3D,coordinates2D,hullIndices)
% Fit a minimum-area rectangle and select actual boundary corner vertices.

    hull2D = coordinates2D(hullIndices,:);

    numberHullPoints = size(hull2D,1);

    bestArea = inf;
    bestAngle = [];
    bestLimits = [];

    %% Test the orientation of each convex-hull edge

    for j = 1:numberHullPoints

        nextPoint = mod(j,numberHullPoints)+1;

        edgeVector = ...
            hull2D(nextPoint,:)-hull2D(j,:);

        if norm(edgeVector) <= eps
            continue
        end

        edgeAngle = atan2( ...
            edgeVector(2),edgeVector(1));

        testAngle = mod(edgeAngle,pi/2);

        cosineAngle = cos(testAngle);
        sineAngle = sin(testAngle);

        rotationMatrix = [
             cosineAngle,  sineAngle
            -sineAngle,    cosineAngle];

        rotatedPoints = ...
            coordinates2D*rotationMatrix';

        minimum1 = min(rotatedPoints(:,1));
        maximum1 = max(rotatedPoints(:,1));

        minimum2 = min(rotatedPoints(:,2));
        maximum2 = max(rotatedPoints(:,2));

        rectangleArea = ...
            (maximum1-minimum1)* ...
            (maximum2-minimum2);

        if rectangleArea < bestArea

            bestArea = rectangleArea;
            bestAngle = testAngle;

            bestLimits = [
                minimum1,maximum1
                minimum2,maximum2];
        end
    end

    if isempty(bestAngle)
        error('Could not fit a rectangle to the end face.');
    end

    %% Rotate all end-face points to the fitted rectangle coordinates

    cosineAngle = cos(bestAngle);
    sineAngle = sin(bestAngle);

    rotationMatrix = [
         cosineAngle,  sineAngle
        -sineAngle,    cosineAngle];

    rotatedPoints = ...
        coordinates2D*rotationMatrix';

    minimum1 = bestLimits(1,1);
    maximum1 = bestLimits(1,2);

    minimum2 = bestLimits(2,1);
    maximum2 = bestLimits(2,2);

    center1 = 0.5*(minimum1+maximum1);
    center2 = 0.5*(minimum2+maximum2);

    halfWidth1 = 0.5*(maximum1-minimum1);
    halfWidth2 = 0.5*(maximum2-minimum2);

    if halfWidth1 <= eps || halfWidth2 <= eps
        error('The fitted end-face rectangle has zero width.');
    end

    %% Normalize the rectangle coordinates

    normalizedCoordinates = zeros(size(rotatedPoints));

    normalizedCoordinates(:,1) = ...
        (rotatedPoints(:,1)-center1)/halfWidth1;

    normalizedCoordinates(:,2) = ...
        (rotatedPoints(:,2)-center2)/halfWidth2;

    %% Select corners by support in four diagonal directions

    % Only convex-hull vertices are allowed.
    hullCoordinates = ...
        normalizedCoordinates(hullIndices,:);

    % Target directions in rectangle coordinates:
    %   (+,+), (+,-), (-,+), (-,-)

    targetDirections = [
         1, 1
         1,-1
        -1, 1
        -1,-1];

    selectedLocalIndex = zeros(4,1);
    selectedPointIndex = zeros(4,1);
    cornerScore = zeros(4,1);

    availableHullPoint = true(numel(hullIndices),1);

    for j = 1:4

        score = ...
            hullCoordinates*targetDirections(j,:)';

        score(~availableHullPoint) = -inf;

        [cornerScore(j),selectedLocalIndex(j)] = max(score);

        selectedPointIndex(j) = ...
            hullIndices(selectedLocalIndex(j));

        availableHullPoint(selectedLocalIndex(j)) = false;
    end

    cornerPoints = ...
        points3D(selectedPointIndex,:);

    %% Calculate distance from ideal rectangle corners

    idealCorners = targetDirections;

    selectedNormalizedCoordinates = ...
        normalizedCoordinates(selectedPointIndex,:);

    normalizedCornerError = sqrt(sum( ...
        (selectedNormalizedCoordinates-idealCorners).^2,2));

    if any(normalizedCornerError > 0.10)

        warning(['One or more selected vertices are relatively far ', ...
                 'from the fitted rectangle corners. Maximum ', ...
                 'normalized error = %g.'], ...
                 max(normalizedCornerError));
    end

    %% Diagnostic results

    rectangleInfo.angleRadians = bestAngle;
    rectangleInfo.angleDegrees = bestAngle*180/pi;
    rectangleInfo.area = bestArea;
    rectangleInfo.limits = bestLimits;

    rectangleInfo.selectedPointIndex = ...
        selectedPointIndex;

    rectangleInfo.selectedNormalizedCoordinates = ...
        selectedNormalizedCoordinates;

    rectangleInfo.normalizedCornerError = ...
        normalizedCornerError;

    rectangleInfo.cornerScore = cornerScore;
end


function neighbors = triangleNeighbors(F)
% Find triangles sharing an entire mesh edge.

    numberTriangles = size(F,1);

    edges = [
        sort(F(:,[1 2]),2)
        sort(F(:,[2 3]),2)
        sort(F(:,[3 1]),2)];

    triangleID = repmat( ...
        (1:numberTriangles)',3,1);

    [edges,sortingIndex] = ...
        sortrows(edges,[1 2]);

    triangleID = triangleID(sortingIndex);

    neighbors = cell(numberTriangles,1);

    firstEdge = 1;

    while firstEdge <= size(edges,1)

        lastEdge = firstEdge;

        while lastEdge < size(edges,1) && ...
                all(edges(lastEdge+1,:) == edges(firstEdge,:))

            lastEdge = lastEdge+1;
        end

        trianglesUsingEdge = unique( ...
            triangleID(firstEdge:lastEdge));

        if numel(trianglesUsingEdge) > 1

            for j = 1:numel(trianglesUsingEdge)

                currentTriangle = ...
                    trianglesUsingEdge(j);

                otherTriangles = ...
                    trianglesUsingEdge( ...
                    trianglesUsingEdge ~= currentTriangle);

                neighbors{currentTriangle} = [
                    neighbors{currentTriangle}, ...
                    otherTriangles'];
            end
        end

        firstEdge = lastEdge+1;
    end
end


function orderedCorners = orderXY(cornerPoints)
% Order corners using global x and y coordinates.

    [~,xOrder] = ...
        sort(cornerPoints(:,1),'descend');

    largerXPoints = ...
        cornerPoints(xOrder(1:2),:);

    smallerXPoints = ...
        cornerPoints(xOrder(3:4),:);

    [~,yOrder] = ...
        sort(largerXPoints(:,2),'descend');

    largerXPoints = ...
        largerXPoints(yOrder,:);

    [~,yOrder] = ...
        sort(smallerXPoints(:,2),'descend');

    smallerXPoints = ...
        smallerXPoints(yOrder,:);

    orderedCorners = [
        largerXPoints
        smallerXPoints];
end


function [V,F] = getMeshArrays(stlData)
% Read arrays from MATLAB stlread output.

    if isa(stlData,'triangulation')

        V = stlData.Points;
        F = stlData.ConnectivityList;

        return
    end

    if ~isstruct(stlData)

        error(['Input must be a triangulation object or a ', ...
               'structure containing faces and vertices.']);
    end

    fieldNames = fieldnames(stlData);

    vertexField = find( ...
        strcmpi(fieldNames,'vertices'),1);

    faceField = find( ...
        strcmpi(fieldNames,'faces'),1);

    if isempty(vertexField) || isempty(faceField)

        error(['The structure must contain fields named ', ...
               'vertices and faces.']);
    end

    V = stlData.(fieldNames{vertexField});
    F = stlData.(fieldNames{faceField});
end
