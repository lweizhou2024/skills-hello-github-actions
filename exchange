function [corners,info] = extractTangCorners_v3(stlData,tol,angleDeg)
%EXTRACTTANGCORNERS_V3 Extract corners from two rectangular tang end faces.
%
% [corners,info] = extractTangCorners_v3(stlData)
% [corners,info] = extractTangCorners_v3(stlData,tol)
% [corners,info] = extractTangCorners_v3(stlData,tol,angleDeg)
%
% INPUT
% -----
% stlData:
%   Output from MATLAB's built-in stlread, normally a triangulation object.
%   A structure containing .faces and .vertices is also accepted.
%
% tol:
%   Coordinate tolerance used only to merge duplicated STL vertices.
%   Leave empty to use the default:
%
%       1e-7 * model bounding-box diagonal
%
% angleDeg:
%   Maximum angle between neighboring end-face triangle normals.
%   Default = 8 degrees.
%
% OUTPUT
% ------
% corners:
%   8-by-3 array with the following row order:
%
%   Higher-z end:
%       1   larger x, larger y
%       2   larger x, smaller y
%       3   smaller x, larger y
%       4   smaller x, smaller y
%
%   Lower-z end:
%       5   larger x, larger y
%       6   larger x, smaller y
%       7   smaller x, larger y
%       8   smaller x, smaller y
%
% info:
%   Diagnostic information about the detected end faces and fitted
%   rectangles.
%
% METHOD
% ------
% 1. Merge geometrically duplicated STL vertices.
% 2. Start separately from the global maximum-z and minimum-z vertices.
% 3. At each end, select the triangle with the largest absolute z-normal.
% 4. Grow the connected end-face surface.
% 5. Project the detected face onto its best-fit plane.
% 6. Fit a minimum-area rectangle to the projected boundary.
% 7. Select the actual STL vertex nearest each fitted rectangle corner.
%
% This method does not require the end face to be perpendicular to z.

    %% Get mesh arrays

    [V,F] = getMeshArrays(stlData);

    V = double(V);
    F = double(F);

    if size(V,2) ~= 3
        error('The vertex array must have three columns.');
    end

    if size(F,2) ~= 3
        error('The face array must have three columns.');
    end

    if any(F(:) < 1) || any(F(:) > size(V,1))
        error('The face array contains invalid vertex indices.');
    end

    %% Default settings

    boundingBoxSize = max(V,[],1) - min(V,[],1);
    modelSize = norm(boundingBoxSize);

    if modelSize <= 0
        error('The STL has zero model size.');
    end

    if nargin < 2 || isempty(tol)
        tol = max(1e-12,1e-7*modelSize);
    end

    if nargin < 3 || isempty(angleDeg)
        angleDeg = 8;
    end

    if tol <= 0
        error('tol must be greater than zero.');
    end

    if angleDeg <= 0 || angleDeg >= 90
        error('angleDeg must be between 0 and 90 degrees.');
    end

    %% Merge geometrically duplicated vertices

    coordinateKey = round(V/tol);

    [~,~,oldToNew] = unique(coordinateKey,'rows');

    numberUniqueVertices = max(oldToNew);

    vertexCount = accumarray(oldToNew,1);

    uniqueVertices = zeros(numberUniqueVertices,3);

    for direction = 1:3

        coordinateSum = accumarray( ...
            oldToNew,V(:,direction));

        uniqueVertices(:,direction) = ...
            coordinateSum./vertexCount;
    end

    uniqueFaces = reshape( ...
        oldToNew(F(:)),size(F));

    V = uniqueVertices;
    F = uniqueFaces;

    %% Remove degenerate triangles and calculate normals

    edge1 = V(F(:,2),:) - V(F(:,1),:);
    edge2 = V(F(:,3),:) - V(F(:,1),:);

    triangleCrossProduct = cross(edge1,edge2,2);

    twiceTriangleArea = sqrt( ...
        sum(triangleCrossProduct.^2,2));

    goodTriangle = ...
        twiceTriangleArea > max(tol^2,eps);

    F = F(goodTriangle,:);
    triangleCrossProduct = ...
        triangleCrossProduct(goodTriangle,:);

    twiceTriangleArea = ...
        twiceTriangleArea(goodTriangle);

    triangleNormals = ...
        triangleCrossProduct ./ ...
        twiceTriangleArea(:,[1 1 1]);

    %% Determine triangle adjacency

    neighbors = triangleNeighbors(F);

    %% Detect the higher-z end face

    [highCorners,highInfo] = growEndCap( ...
        V,F,triangleNormals,neighbors, ...
        +1,tol,modelSize,angleDeg);

    %% Detect the lower-z end face

    [lowCorners,lowInfo] = growEndCap( ...
        V,F,triangleNormals,neighbors, ...
        -1,tol,modelSize,angleDeg);

    %% Order the coordinates

    highCorners = orderXY(highCorners);
    lowCorners = orderXY(lowCorners);

    corners = [
        highCorners
        lowCorners];

    %% Diagnostic output

    info.highEnd = highInfo;
    info.lowEnd = lowInfo;

    info.tolerance = tol;
    info.angleDeg = angleDeg;
    info.modelSize = modelSize;
end


function [cornerPoints,endInfo] = growEndCap( ...
    V,F,N,neighbors,zSign,tol,modelSize,angleDeg)
%GROWENDCAP Start at one z extreme and grow the connected end face.

    %% Find vertices at the requested z extremity

    if zSign > 0

        zExtreme = max(V(:,3));

        extremeVertexIDs = find( ...
            V(:,3) >= zExtreme-5*tol);

    else

        zExtreme = min(V(:,3));

        extremeVertexIDs = find( ...
            V(:,3) <= zExtreme+5*tol);
    end

    %% Find triangles touching an extreme vertex

    touchingExtremeVertex = ...
        ismember(F,extremeVertexIDs);

    touchingTriangles = find( ...
        any(touchingExtremeVertex,2));

    if isempty(touchingTriangles)

        error(['No triangles were found at one z extremity. ', ...
               'Try increasing tol slightly.']);
    end

    %% Choose the initial end-face triangle

    % At an end corner, triangles from both the cap and tang sides may
    % touch the extreme vertex. The cap triangle normally has the largest
    % absolute z component in its normal.

    [largestNormalZ,localSeedIndex] = ...
        max(abs(N(touchingTriangles,3)));

    seedTriangle = ...
        touchingTriangles(localSeedIndex);

    if largestNormalZ < 0.10

        error(['The triangles at a z extremity have almost no ', ...
               'z-normal component. The tang end may be nearly ', ...
               'parallel to the stacking axis.']);
    end

    referenceNormal = N(seedTriangle,:);

    referencePoint = ...
        V(F(seedTriangle,1),:);

    %% Grow the connected end-face surface

    cosineLimit = cos(angleDeg*pi/180);

    % This plane tolerance is separate from the vertex-merging tolerance.
    % It allows small STL surface noise without merging distinct vertices.

    planeTolerance = max( ...
        50*tol,1e-4*modelSize);

    usedTriangle = false(size(F,1),1);
    usedTriangle(seedTriangle) = true;

    triangleQueue = seedTriangle;
    queuePosition = 1;

    while queuePosition <= numel(triangleQueue)

        currentTriangle = ...
            triangleQueue(queuePosition);

        queuePosition = queuePosition+1;

        adjacentTriangles = ...
            neighbors{currentTriangle};

        for j = 1:numel(adjacentTriangles)

            candidateTriangle = ...
                adjacentTriangles(j);

            if usedTriangle(candidateTriangle)
                continue
            end

            %% Compare triangle normal

            % abs(dot) allows inconsistent STL triangle winding.

            normalDotProduct = abs(dot( ...
                N(candidateTriangle,:), ...
                referenceNormal));

            normalOK = ...
                normalDotProduct >= cosineLimit;

            %% Compare distance from the initial cap plane

            candidatePoints = ...
                V(F(candidateTriangle,:),:);

            planeDistance = abs( ...
                (candidatePoints-referencePoint)* ...
                referenceNormal');

            planeOK = ...
                max(planeDistance) <= planeTolerance;

            %% Add acceptable neighboring triangle

            if normalOK && planeOK

                usedTriangle(candidateTriangle) = true;

                triangleQueue(end+1) = ...
                    candidateTriangle; %#ok<AGROW>
            end
        end
    end

    endTriangleIDs = find(usedTriangle);

    endVertexIDs = unique( ...
        F(endTriangleIDs,:));

    endPoints = V(endVertexIDs,:);

    if size(endPoints,1) < 4

        error(['The detected end surface contains fewer than ', ...
               'four vertices. Try increasing angleDeg.']);
    end

    %% Project the end face onto its best-fit plane

    faceCenter = mean(endPoints,1);

    centeredPoints = ...
        endPoints-faceCenter;

    [~,~,planeBasis] = ...
        svd(centeredPoints,0);

    coordinates2D = ...
        centeredPoints*planeBasis(:,1:2);

    %% Find the convex hull

    hullIndices = convhull( ...
        coordinates2D(:,1), ...
        coordinates2D(:,2));

    % convhull repeats the first point.
    hullIndices(end) = [];

    if numel(hullIndices) < 4

        error(['The detected end-face boundary contains fewer ', ...
               'than four convex-hull vertices.']);
    end

    %% Fit a rectangle and select actual corner vertices

    [cornerPoints,rectangleInfo] = ...
        fitRectangleCorners( ...
        endPoints,coordinates2D,hullIndices);

    %% Save diagnostic information

    endInfo.seedTriangle = seedTriangle;

    endInfo.triangleIDs = ...
        endTriangleIDs;

    endInfo.vertexIDs = ...
        endVertexIDs;

    endInfo.vertices = ...
        endPoints;

    endInfo.referenceNormal = ...
        referenceNormal;

    endInfo.zExtreme = ...
        zExtreme;

    endInfo.planeTolerance = ...
        planeTolerance;

    endInfo.faceCenter = ...
        faceCenter;

    endInfo.planeBasis = ...
        planeBasis;

    endInfo.coordinates2D = ...
        coordinates2D;

    endInfo.hullIndices = ...
        hullIndices;

    endInfo.rectangle = ...
        rectangleInfo;
end


function [cornerPoints,rectangleInfo] = ...
    fitRectangleCorners(points3D,coordinates2D,hullIndices)
%FITRECTANGLECORNERS Fit a minimum-area rectangle to the end-face boundary.
%
% This avoids trying to remove every nearly collinear STL boundary point.
% The fitted rectangle corners are then matched to actual STL vertices.

    hull2D = ...
        coordinates2D(hullIndices,:);

    numberHullPoints = ...
        size(hull2D,1);

    bestArea = inf;
    bestAngle = [];
    bestLimits = [];

    %% Test the direction of every hull edge

    for j = 1:numberHullPoints

        nextPoint = ...
            mod(j,numberHullPoints)+1;

        edgeVector = ...
            hull2D(nextPoint,:) - hull2D(j,:);

        edgeLength = norm(edgeVector);

        if edgeLength <= eps
            continue
        end

        edgeAngle = atan2( ...
            edgeVector(2),edgeVector(1));

        % A rectangle orientation repeats every 90 degrees.
        testAngle = mod(edgeAngle,pi/2);

        cosineAngle = cos(testAngle);
        sineAngle = sin(testAngle);

        rotationMatrix = [
             cosineAngle,  sineAngle
            -sineAngle,    cosineAngle];

        rotatedPoints = ...
            coordinates2D*rotationMatrix';

        minimumCoordinate1 = ...
            min(rotatedPoints(:,1));

        maximumCoordinate1 = ...
            max(rotatedPoints(:,1));

        minimumCoordinate2 = ...
            min(rotatedPoints(:,2));

        maximumCoordinate2 = ...
            max(rotatedPoints(:,2));

        rectangleArea = ...
            (maximumCoordinate1-minimumCoordinate1)* ...
            (maximumCoordinate2-minimumCoordinate2);

        if rectangleArea < bestArea

            bestArea = rectangleArea;
            bestAngle = testAngle;

            bestLimits = [
                minimumCoordinate1,maximumCoordinate1
                minimumCoordinate2,maximumCoordinate2];
        end
    end

    if isempty(bestAngle)

        error(['A rectangle could not be fitted to the ', ...
               'detected end-face boundary.']);
    end

    %% Define fitted rectangle corners in rotated coordinates

    minimumCoordinate1 = bestLimits(1,1);
    maximumCoordinate1 = bestLimits(1,2);

    minimumCoordinate2 = bestLimits(2,1);
    maximumCoordinate2 = bestLimits(2,2);

    fittedCornersRotated = [
        maximumCoordinate1, maximumCoordinate2
        maximumCoordinate1, minimumCoordinate2
        minimumCoordinate1, maximumCoordinate2
        minimumCoordinate1, minimumCoordinate2];

    %% Transform fitted corners back to projected face coordinates

    cosineAngle = cos(bestAngle);
    sineAngle = sin(bestAngle);

    rotationMatrix = [
         cosineAngle,  sineAngle
        -sineAngle,    cosineAngle];

    fittedCorners2D = ...
        fittedCornersRotated*rotationMatrix;

    %% Match each fitted corner to an actual boundary vertex

    numberPoints = size(points3D,1);

    isHullPoint = false(numberPoints,1);
    isHullPoint(hullIndices) = true;

    availablePoint = isHullPoint;

    selectedPointIndex = zeros(4,1);
    cornerError = zeros(4,1);
    cornerPoints = zeros(4,3);

    for j = 1:4

        coordinateDifference = ...
            coordinates2D - fittedCorners2D(j,:);

        distanceSquared = ...
            sum(coordinateDifference.^2,2);

        % Only boundary points can be selected.
        distanceSquared(~availablePoint) = inf;

        [minimumDistanceSquared,selectedPointIndex(j)] = ...
            min(distanceSquared);

        if ~isfinite(minimumDistanceSquared)

            error(['A unique STL boundary point could not be ', ...
                   'assigned to every fitted rectangle corner.']);
        end

        cornerPoints(j,:) = ...
            points3D(selectedPointIndex(j),:);

        cornerError(j) = ...
            sqrt(minimumDistanceSquared);

        % Prevent the same STL vertex from being selected twice.
        availablePoint(selectedPointIndex(j)) = false;
    end

    %% Check quality of fitted corners

    faceRange = ...
        max(coordinates2D,[],1) - ...
        min(coordinates2D,[],1);

    faceScale = norm(faceRange);

    normalizedCornerError = ...
        cornerError/max(faceScale,eps);

    if any(normalizedCornerError > 0.02)

        warning(['One or more fitted corners are relatively far ', ...
                 'from an actual STL boundary vertex. Maximum ', ...
                 'normalized corner error = %g.'], ...
                 max(normalizedCornerError));
    end

    %% Diagnostic results

    rectangleInfo.angleRadians = bestAngle;
    rectangleInfo.angleDegrees = bestAngle*180/pi;

    rectangleInfo.area = bestArea;

    rectangleInfo.fittedCorners2D = ...
        fittedCorners2D;

    rectangleInfo.selectedPointIndex = ...
        selectedPointIndex;

    rectangleInfo.cornerError = ...
        cornerError;

    rectangleInfo.normalizedCornerError = ...
        normalizedCornerError;
end


function neighbors = triangleNeighbors(F)
%TRIANGLENEIGHBORS Find triangles that share an entire edge.

    numberTriangles = size(F,1);

    edges = [
        sort(F(:,[1 2]),2)
        sort(F(:,[2 3]),2)
        sort(F(:,[3 1]),2)];

    triangleID = repmat( ...
        (1:numberTriangles)',3,1);

    [edges,sortingIndex] = ...
        sortrows(edges,[1 2]);

    triangleID = ...
        triangleID(sortingIndex);

    neighbors = ...
        cell(numberTriangles,1);

    firstEdge = 1;

    while firstEdge <= size(edges,1)

        lastEdge = firstEdge;

        while lastEdge < size(edges,1) && ...
                all(edges(lastEdge+1,:) == edges(firstEdge,:))

            lastEdge = lastEdge+1;
        end

        trianglesUsingEdge = unique( ...
            triangleID(firstEdge:lastEdge));

        if numel(trianglesUsingEdge) > 1

            for j = 1:numel(trianglesUsingEdge)

                currentTriangle = ...
                    trianglesUsingEdge(j);

                otherTriangles = ...
                    trianglesUsingEdge( ...
                    trianglesUsingEdge ~= currentTriangle);

                neighbors{currentTriangle} = [
                    neighbors{currentTriangle}, ...
                    otherTriangles'];
            end
        end

        firstEdge = lastEdge+1;
    end
end


function orderedCorners = orderXY(cornerPoints)
%ORDERXY Order four corners using global x and y coordinates.
%
% Output order:
%   1  larger x, larger y
%   2  larger x, smaller y
%   3  smaller x, larger y
%   4  smaller x, smaller y

    if size(cornerPoints,1) ~= 4
        error('Exactly four corner points are required.');
    end

    [~,xOrder] = ...
        sort(cornerPoints(:,1),'descend');

    largerXPoints = ...
        cornerPoints(xOrder(1:2),:);

    smallerXPoints = ...
        cornerPoints(xOrder(3:4),:);

    [~,largerXYOrder] = ...
        sort(largerXPoints(:,2),'descend');

    largerXPoints = ...
        largerXPoints(largerXYOrder,:);

    [~,smallerXYOrder] = ...
        sort(smallerXPoints(:,2),'descend');

    smallerXPoints = ...
        smallerXPoints(smallerXYOrder,:);

    orderedCorners = [
        largerXPoints
        smallerXPoints];
end


function [V,F] = getMeshArrays(stlData)
%GETMESHARRAYS Read arrays from stlread output.

    if isa(stlData,'triangulation')

        V = stlData.Points;
        F = stlData.ConnectivityList;

        return
    end

    if ~isstruct(stlData)

        error(['Input must be either a triangulation object ', ...
               'or a structure containing faces and vertices.']);
    end

    fieldNames = fieldnames(stlData);

    vertexField = find( ...
        strcmpi(fieldNames,'vertices'),1);

    faceField = find( ...
        strcmpi(fieldNames,'faces'),1);

    if isempty(vertexField) || isempty(faceField)

        error(['The input structure must contain fields named ', ...
               'vertices and faces.']);
    end

    V = stlData.(fieldNames{vertexField});
    F = stlData.(fieldNames{faceField});
end
