filename = 'myVideo.mp4';
v = VideoReader(filename);

frameNumber = 0;

figure;

while hasFrame(v)
    try
        frame = readFrame(v);
        frameNumber = frameNumber + 1;

        % Display every 10th decoded frame
        if mod(frameNumber, 10) == 1
            imshow(frame);
            title(sprintf('Decoded frame %d, time %.3f s', ...
                frameNumber, v.CurrentTime));
            drawnow;
        end

    catch ME
        fprintf('Reading failed near frame %d, time %.3f seconds.\n', ...
            frameNumber + 1, v.CurrentTime);
        fprintf('Error: %s\n', ME.message);
        break
    end
end

fprintf('Successfully decoded %d frames.\n', frameNumber);
