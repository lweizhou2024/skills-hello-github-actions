function [E, G, mu, nIter] = e1876_rect_bar(b, t, L, m, ff, ft, tol, maxIter)
%E1876_RECT_BAR  Dynamic Young's modulus, shear modulus and Poisson's ratio
%   of a rectangular bar from the fundamental free-free flexural and
%   torsional resonant frequencies (ASTM E1876, current R-factor form).
%
%   [E,G,mu,nIter] = e1876_rect_bar(b,t,L,m,ff,ft)
%   [E,G,mu,nIter] = e1876_rect_bar(b,t,L,m,ff,ft,tol,maxIter)
%
%   INPUTS
%     b  - width       [mm]
%     t  - thickness   [mm]
%     L  - length      [mm]
%     m  - mass        [g]
%     ff - fundamental flexural frequency   [Hz]
%     ft - fundamental torsional frequency  [Hz]
%     tol, maxIter - optional (defaults 1e-8, 100)
%
%   OUTPUTS
%     E  - Young's modulus [GPa]
%     G  - shear modulus   [GPa]
%     mu - Poisson's ratio [-]
%
%   Unit note: with mm and g, the product (g/mm)*Hz^2 equals kg/(m*s^2) = Pa,
%   so the formulas can be used directly and the result divided by 1e9 for GPa.

    if nargin < 7 || isempty(tol),     tol = 1e-8;  end
    if nargin < 8 || isempty(maxIter), maxIter = 100; end

    if any([b t L m ff ft] <= 0)
        error('All inputs must be positive.');
    end
    if L/t < 5
        warning('L/t = %.2f < 5: outside the usual E1876 recommended geometry.', L/t);
    end

    n  = 1;                 % torsional mode order (fundamental)
    bt = b/t;
    tb = t/b;

    % ---- shear modulus: R factor (independent of mu) ----
    R1 = (1 + bt^2) / (4 - 2.521*tb*(1 - 1.991/(exp(pi*bt) + 1)));
    R2 = 1 + 0.00851*n^2*b^2/L^2;
    R3 = 0.060*(n*b/L)^1.5 * (bt - 1)^2;
    R  = R1*R2 - R3;

    G_Pa = (4*L*m*ft^2 / (b*t)) * R;            % Pa (mm, g inputs)

    % ---- flexural modulus, iterate on mu ----
    tL  = t/L;
    Ef0 = 0.9465 * (m*ff^2/b) * (L^3/t^3);      % Pa (mm, g inputs)

    T1fun = @(mu) 1 + 6.585*(1 + 0.0752*mu + 0.8109*mu^2)*tL^2 ...
                  - 0.868*tL^4 ...
                  - (8.340*(1 + 0.2023*mu + 2.173*mu^2)*tL^4) / ...
                    (1 + 6.338*(1 + 0.1408*mu + 1.536*mu^2)*tL^2);

    mu = 0.3;                                    % initial guess
    converged = false;
    for nIter = 1:maxIter
        E_Pa  = Ef0 * T1fun(mu);
        muNew = E_Pa/(2*G_Pa) - 1;
        if abs(muNew - mu) < tol
            mu = muNew;
            converged = true;
            break;
        end
        mu = muNew;
    end
    if ~converged
        warning('e1876_rect_bar:noConv', ...
                'Did not converge in %d iterations (last mu = %.6f).', maxIter, mu);
    end

    E_Pa = Ef0 * T1fun(mu);                      % final E with converged mu

    E = E_Pa/1e9;                                % GPa
    G = G_Pa/1e9;                                % GPa
end
