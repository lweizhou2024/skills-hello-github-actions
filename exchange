[largeXEndpoints,smallXEndpoints,sideInfo] = ...
    findTwoStraightSides( ...
    boundaryEdges,V,modelSize);

largeXInfo = sideInfo.largeX;
smallXInfo = sideInfo.smallX;


function [largeXEndpoints,smallXEndpoints,sideInfo] = ...
    findTwoStraightSides(boundaryEdges,V,modelSize)
%FINDTWOSTRAIGHTSIDES Find the two straight side runs of the boundary.
%
% The boundary is first ordered into a continuous loop. Consecutive
% collinear edges are merged into straight runs. The two long runs that
% extend mainly in y and lie on opposite x sides are selected.

    %% Order boundary vertices into a continuous loop

    boundaryVertexLoop = ...
        orderBoundaryLoop(boundaryEdges);

    P = V(boundaryVertexLoop,:);

    numberPoints = size(P,1);

    if numberPoints < 4
        error('The end-face boundary has fewer than four vertices.');
    end

    %% Boundary dimensions

    xRange = max(P(:,1))-min(P(:,1));
    yRange = max(P(:,2))-min(P(:,2));

    if xRange <= eps || yRange <= eps
        error('The end-face boundary has zero x or y range.');
    end

    xCenter = 0.5*(max(P(:,1))+min(P(:,1)));

    %% Settings for grouping consecutive collinear edges

    lineAngleToleranceDeg = 2.0;

    cosineLimit = ...
        cos(lineAngleToleranceDeg*pi/180);

    lineDistanceTolerance = max( ...
        1e-7*modelSize, ...
        1e-5*max(xRange,yRange));

    %% Find every possible consecutive straight run

    runs = struct( ...
        'startIndex',{}, ...
        'endIndex',{}, ...
        'numberEdges',{}, ...
        'endpoint1',{}, ...
        'endpoint2',{}, ...
        'midpoint',{}, ...
        'length',{}, ...
        'ySpan',{}, ...
        'verticalFraction',{}, ...
        'indices',{});

    numberRuns = 0;

    for startIndex = 1:numberPoints

        nextIndex = mod(startIndex,numberPoints)+1;

        firstVector = P(nextIndex,:)-P(startIndex,:);

        firstLength = norm(firstVector);

        if firstLength <= eps
            continue
        end

        referenceDirection = ...
            firstVector/firstLength;

        referencePoint = ...
            P(startIndex,:);

        runIndices = startIndex;

        currentIndex = startIndex;
        numberEdges = 0;

        while numberEdges < numberPoints-1

            followingIndex = ...
                mod(currentIndex,numberPoints)+1;

            currentVector = ...
                P(followingIndex,:)-P(currentIndex,:);

            currentLength = norm(currentVector);

            if currentLength <= eps
                break
            end

            currentDirection = ...
                currentVector/currentLength;

            %% Require the next edge to remain parallel to the first edge

            directionOK = ...
                dot(currentDirection,referenceDirection) >= cosineLimit;

            if ~directionOK
                break
            end

            %% Require the next vertex to remain on the same straight line

            vectorFromLine = ...
                P(followingIndex,:)-referencePoint;

            lineProjection = ...
                dot(vectorFromLine,referenceDirection);

            closestPoint = ...
                referencePoint + ...
                lineProjection*referenceDirection;

            distanceFromLine = ...
                norm(P(followingIndex,:)-closestPoint);

            lineOK = ...
                distanceFromLine <= lineDistanceTolerance;

            if ~lineOK
                break
            end

            runIndices(end+1) = followingIndex; %#ok<AGROW>

            numberEdges = numberEdges+1;
            currentIndex = followingIndex;
        end

        if numberEdges < 1
            continue
        end

        endpoint1 = P(runIndices(1),:);
        endpoint2 = P(runIndices(end),:);

        runVector = endpoint2-endpoint1;
        runLength = norm(runVector);

        if runLength <= eps
            continue
        end

        runXYLength = norm(runVector(1:2));

        if runXYLength <= eps
            continue
        end

        verticalFraction = ...
            abs(runVector(2))/runXYLength;

        ySpan = ...
            abs(endpoint2(2)-endpoint1(2));

        numberRuns = numberRuns+1;

        runs(numberRuns).startIndex = ...
            runIndices(1);

        runs(numberRuns).endIndex = ...
            runIndices(end);

        runs(numberRuns).numberEdges = ...
            numberEdges;

        runs(numberRuns).endpoint1 = ...
            endpoint1;

        runs(numberRuns).endpoint2 = ...
            endpoint2;

        runs(numberRuns).midpoint = ...
            0.5*(endpoint1+endpoint2);

        runs(numberRuns).length = ...
            runLength;

        runs(numberRuns).ySpan = ...
            ySpan;

        runs(numberRuns).verticalFraction = ...
            verticalFraction;

        runs(numberRuns).indices = ...
            runIndices;
    end

    if numel(runs) < 2
        error('Fewer than two straight boundary runs were detected.');
    end

    %% Retain runs that can represent a left or right side

    allYSpan = [runs.ySpan]';
    allVerticalFraction = [runs.verticalFraction]';

    % The straight sides connect the upper and lower curved boundaries,
    % so they should have substantial y extent.

    minimumYSpan = 0.25*yRange;

    acceptable = ...
        allYSpan >= minimumYSpan & ...
        allVerticalFraction >= 0.50;

    candidateRuns = runs(acceptable);

    if numel(candidateRuns) < 2

        % Relax the y-span criterion if the tang is strongly inclined.
        acceptable = ...
            allYSpan >= 0.10*yRange & ...
            allVerticalFraction >= 0.40;

        candidateRuns = runs(acceptable);
    end

    if numel(candidateRuns) < 2

        error(['Could not identify two long, mostly y-directed ', ...
               'straight boundary runs.']);
    end

    %% Remove duplicate runs

    candidateRuns = ...
        removeDuplicateRuns(candidateRuns);

    if numel(candidateRuns) < 2

        error(['Only one distinct straight side run was found ', ...
               'on the end-face boundary.']);
    end

    %% Score candidates by x side, length and y extent

    numberCandidates = ...
        numel(candidateRuns);

    rightScore = -inf(numberCandidates,1);
    leftScore = -inf(numberCandidates,1);

    for j = 1:numberCandidates

        meanX = ...
            candidateRuns(j).midpoint(1);

        normalizedX = ...
            (meanX-xCenter)/xRange;

        normalizedYSpan = ...
            candidateRuns(j).ySpan/yRange;

        normalizedLength = ...
            candidateRuns(j).length/ ...
            max(xRange,yRange);

        % Position is the primary criterion. Span and length are secondary.

        rightScore(j) = ...
            normalizedX + ...
            0.20*normalizedYSpan + ...
            0.05*normalizedLength;

        leftScore(j) = ...
            -normalizedX + ...
            0.20*normalizedYSpan + ...
            0.05*normalizedLength;
    end

    %% Select larger-x side

    [~,largeXRunIndex] = ...
        max(rightScore);

    %% Select smaller-x side, excluding the already selected run

    leftScore(largeXRunIndex) = -inf;

    [~,smallXRunIndex] = ...
        max(leftScore);

    largeXRun = ...
        candidateRuns(largeXRunIndex);

    smallXRun = ...
        candidateRuns(smallXRunIndex);

    %% Verify that the selected runs are on opposite x sides

    if largeXRun.midpoint(1) <= smallXRun.midpoint(1)

        error(['The two detected straight runs could not be ', ...
               'separated into larger-x and smaller-x sides.']);
    end

    %% Extract endpoints

    largeXEndpoints = [
        largeXRun.endpoint1
        largeXRun.endpoint2];

    smallXEndpoints = [
        smallXRun.endpoint1
        smallXRun.endpoint2];

    %% Put larger-y endpoint first on each side

    if largeXEndpoints(1,2) < largeXEndpoints(2,2)

        largeXEndpoints = ...
            largeXEndpoints([2 1],:);
    end

    if smallXEndpoints(1,2) < smallXEndpoints(2,2)

        smallXEndpoints = ...
            smallXEndpoints([2 1],:);
    end

    %% Diagnostic information

    sideInfo.largeX = largeXRun;
    sideInfo.largeX.endpoints = largeXEndpoints;

    sideInfo.smallX = smallXRun;
    sideInfo.smallX.endpoints = smallXEndpoints;

    sideInfo.boundaryVertexLoop = ...
        boundaryVertexLoop;

    sideInfo.boundaryPointsInOrder = ...
        P;

    sideInfo.allRuns = runs;

    sideInfo.candidateRuns = candidateRuns;

    sideInfo.lineAngleToleranceDeg = ...
        lineAngleToleranceDeg;

    sideInfo.lineDistanceTolerance = ...
        lineDistanceTolerance;
end


function boundaryVertexLoop = orderBoundaryLoop(boundaryEdges)
%ORDERBOUNDARYLOOP Put boundary-edge vertices into continuous loop order.

    boundaryVertexIDs = ...
        unique(boundaryEdges(:));

    maximumVertexID = ...
        max(boundaryVertexIDs);

    vertexNeighbors = ...
        cell(maximumVertexID,1);

    for j = 1:size(boundaryEdges,1)

        vertex1 = boundaryEdges(j,1);
        vertex2 = boundaryEdges(j,2);

        vertexNeighbors{vertex1}(end+1) = vertex2;
        vertexNeighbors{vertex2}(end+1) = vertex1;
    end

    %% A simple closed boundary must have two neighbors per vertex

    for j = 1:numel(boundaryVertexIDs)

        vertexID = boundaryVertexIDs(j);

        vertexNeighbors{vertexID} = ...
            unique(vertexNeighbors{vertexID});

        if numel(vertexNeighbors{vertexID}) ~= 2

            error(['The detected end-face boundary is not one ', ...
                   'simple closed loop. Boundary vertex %d has ', ...
                   '%d neighbors.'], ...
                   vertexID,numel(vertexNeighbors{vertexID}));
        end
    end

    %% Walk around the loop

    startVertex = boundaryVertexIDs(1);

    boundaryVertexLoop = ...
        zeros(numel(boundaryVertexIDs),1);

    boundaryVertexLoop(1) = ...
        startVertex;

    previousVertex = 0;
    currentVertex = startVertex;

    for j = 2:numel(boundaryVertexIDs)

        nextCandidates = ...
            vertexNeighbors{currentVertex};

        if previousVertex == 0

            nextVertex = ...
                nextCandidates(1);

        else

            nextCandidates = ...
                nextCandidates( ...
                nextCandidates ~= previousVertex);

            if isempty(nextCandidates)

                error('The boundary loop ended unexpectedly.');
            end

            nextVertex = ...
                nextCandidates(1);
        end

        boundaryVertexLoop(j) = ...
            nextVertex;

        previousVertex = currentVertex;
        currentVertex = nextVertex;
    end

    %% Verify loop closure

    if ~any(vertexNeighbors{currentVertex} == startVertex)

        error('The detected end-face boundary does not close.');
    end
end


function uniqueRuns = removeDuplicateRuns(runs)
%REMOVEDUPLICATERUNS Remove repeated versions of the same straight run.

    keep = true(numel(runs),1);

    for j = 1:numel(runs)-1

        if ~keep(j)
            continue
        end

        endpointsJ = sort([
            runs(j).startIndex
            runs(j).endIndex]);

        for k = j+1:numel(runs)

            if ~keep(k)
                continue
            end

            endpointsK = sort([
                runs(k).startIndex
                runs(k).endIndex]);

            if all(endpointsJ == endpointsK)

                % Retain the version with the larger span.

                if runs(k).length > runs(j).length

                    keep(j) = false;
                    break

                else

                    keep(k) = false;
                end
            end
        end
    end

    uniqueRuns = runs(keep);
end
