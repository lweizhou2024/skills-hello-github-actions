function [corners, info] = extractTangCorners_v2(stlData, tol, angleDeg)
%EXTRACTTANGCORNERS_V2 Extract corners from both rectangular tang end faces.
%
% [corners,info] = extractTangCorners_v2(stlData)
% [corners,info] = extractTangCorners_v2(stlData,tol,angleDeg)
%
% stlData can be:
%   1. A structure containing .faces and .vertices
%   2. A MATLAB triangulation object
%
% corners is an 8-by-3 array ordered as:
%
% Higher-z tang end:
%   1  larger x, larger y
%   2  larger x, smaller y
%   3  smaller x, larger y
%   4  smaller x, smaller y
%
% Lower-z tang end:
%   5  larger x, larger y
%   6  larger x, smaller y
%   7  smaller x, larger y
%   8  smaller x, smaller y
%
% The search starts from the global maximum- and minimum-z vertices.
% Therefore, a rectangular shoulder face should not be selected merely
% because it is more planar than the tang end.
%
% tol:
%   Coordinate tolerance used to merge duplicated STL vertices.
%
% angleDeg:
%   Maximum normal-angle variation allowed while growing the end cap.
%   Default is 8 degrees.

    [V,F] = getMeshArrays(stlData);

    V = double(V);
    F = double(F);

    if size(V,2) ~= 3 || size(F,2) ~= 3
        error('vertices and faces must each have three columns.');
    end

    modelSize = norm(max(V,[],1) - min(V,[],1));

    if nargin < 2 || isempty(tol)
        tol = max(1e-12,1e-7*modelSize);
    end

    if nargin < 3 || isempty(angleDeg)
        angleDeg = 8;
    end

    %% Merge geometrically duplicated STL vertices

    key = round(V/tol);

    [~,~,map] = unique(key,'rows');

    numberUnique = max(map);
    count = accumarray(map,1);

    Vu = zeros(numberUnique,3);

    for j = 1:3
        Vu(:,j) = accumarray(map,V(:,j))./count;
    end

    Fu = reshape(map(F(:)),size(F));

    %% Calculate triangle normals

    edge1 = Vu(Fu(:,2),:) - Vu(Fu(:,1),:);
    edge2 = Vu(Fu(:,3),:) - Vu(Fu(:,1),:);

    normalVector = cross(edge1,edge2,2);
    normalMagnitude = sqrt(sum(normalVector.^2,2));

    goodTriangle = normalMagnitude > max(tol^2,eps);

    Fu = Fu(goodTriangle,:);
    normalVector = normalVector(goodTriangle,:);
    normalMagnitude = normalMagnitude(goodTriangle);

    N = normalVector./normalMagnitude(:,[1 1 1]);

    %% Create triangle adjacency information

    neighbors = triangleNeighbors(Fu);

    %% Find the two tang end caps

    [highCorners,highInfo] = growEndCap( ...
        Vu,Fu,N,neighbors,+1,tol,modelSize,angleDeg);

    [lowCorners,lowInfo] = growEndCap( ...
        Vu,Fu,N,neighbors,-1,tol,modelSize,angleDeg);

    %% Put corners into requested order

    highCorners = orderXY(highCorners);
    lowCorners  = orderXY(lowCorners);

    corners = [highCorners;lowCorners];

    info.highEnd = highInfo;
    info.lowEnd = lowInfo;
    info.tolerance = tol;
    info.angleDeg = angleDeg;
end


function [C,out] = growEndCap( ...
    V,F,N,neighbors,zSign,tol,modelSize,angleDeg)
% Start from one global z extremity and grow the connected end cap.

    %% Find vertices at the requested z extremity

    if zSign > 0
        zExtreme = max(V(:,3));

        extremeVertices = find( ...
            V(:,3) >= zExtreme - 5*tol);
    else
        zExtreme = min(V(:,3));

        extremeVertices = find( ...
            V(:,3) <= zExtreme + 5*tol);
    end

    %% Find all triangles touching those vertices

    touchingExtreme = ismember(F,extremeVertices);
    touchingTriangles = find(any(touchingExtreme,2));

    if isempty(touchingTriangles)
        error(['No triangle was found at one z extremity. ', ...
               'Try increasing tol.']);
    end

    %% Select the end-cap seed triangle

    % At an end corner, both end-cap and tang-side triangles can occur.
    % The end-cap triangle is assumed to have the largest absolute
    % z component of its normal.

    [largestNormalZ,index] = ...
        max(abs(N(touchingTriangles,3)));

    seedTriangle = touchingTriangles(index);

    if largestNormalZ < 0.10
        error(['The triangles at the z extremity have almost no ', ...
               'z-normal component. The tang end may be nearly ', ...
               'parallel to the stacking axis.']);
    end

    referenceNormal = N(seedTriangle,:);
    referencePoint = V(F(seedTriangle,1),:);

    %% Grow the connected end-cap surface

    cosineLimit = cos(angleDeg*pi/180);

    % This prevents the surface growth from crossing a sharp shoulder.
    planeTolerance = max(50*tol,1e-4*modelSize);

    used = false(size(F,1),1);
    used(seedTriangle) = true;

    queue = seedTriangle;
    queuePosition = 1;

    while queuePosition <= numel(queue)

        currentTriangle = queue(queuePosition);
        queuePosition = queuePosition + 1;

        adjacentTriangles = neighbors{currentTriangle};

        for j = 1:numel(adjacentTriangles)

            candidateTriangle = adjacentTriangles(j);

            if used(candidateTriangle)
                continue
            end

            % Triangle winding may be inconsistent, so use abs(dot).
            normalOK = abs(dot( ...
                N(candidateTriangle,:),referenceNormal)) ...
                >= cosineLimit;

            candidatePoints = ...
                V(F(candidateTriangle,:),:);

            planeDistance = abs( ...
                (candidatePoints-referencePoint)* ...
                referenceNormal');

            planeOK = max(planeDistance) <= planeTolerance;

            if normalOK && planeOK
                used(candidateTriangle) = true;

                queue(end+1) = candidateTriangle; %#ok<AGROW>
            end
        end
    end

    endTriangles = find(used);

    endVertexIDs = unique(F(endTriangles,:));
    endPoints = V(endVertexIDs,:);

    if size(endPoints,1) < 4
        error(['The detected tang end contains fewer than four ', ...
               'vertices. Try increasing angleDeg or tol.']);
    end

    %% Project the end cap onto its best-fit plane

    center = mean(endPoints,1);

    [~,~,basis] = svd(endPoints-center,0);

    localCoordinates = ...
        (endPoints-center)*basis(:,1:2);

    %% Find the outer boundary

    hullIndices = convhull( ...
        localCoordinates(:,1), ...
        localCoordinates(:,2));

    % convhull repeats the first index at the end.
    hullIndices(end) = [];

    %% Remove intermediate collinear edge points

    lineTolerance = max( ...
        10*tol,1e-6*modelSize);

    hullIndices = removeCollinear( ...
        hullIndices,localCoordinates,lineTolerance);

    if numel(hullIndices) ~= 4
        error(['The surface grown from the z extreme has %d ', ...
               'boundary corners instead of 4. Try calling ', ...
               'extractTangCorners_v2(stl,[],15).'], ...
               numel(hullIndices));
    end

    C = endPoints(hullIndices,:);

    %% Diagnostic output

    out.seedTriangle = seedTriangle;
    out.triangles = endTriangles;
    out.vertexIDs = endVertexIDs;
    out.vertices = endPoints;
    out.normal = referenceNormal;
    out.zExtreme = zExtreme;
end


function neighbors = triangleNeighbors(F)
% Build a list of triangles sharing an edge.

    numberTriangles = size(F,1);

    edges = [
        sort(F(:,[1 2]),2)
        sort(F(:,[2 3]),2)
        sort(F(:,[3 1]),2)];

    triangleID = repmat( ...
        (1:numberTriangles)',3,1);

    [edges,sortIndex] = sortrows(edges,[1 2]);

    triangleID = triangleID(sortIndex);

    neighbors = cell(numberTriangles,1);

    firstEdge = 1;

    while firstEdge <= size(edges,1)

        lastEdge = firstEdge;

        while lastEdge < size(edges,1) && ...
                all(edges(lastEdge+1,:) == ...
                    edges(firstEdge,:))

            lastEdge = lastEdge + 1;
        end

        triangleGroup = unique( ...
            triangleID(firstEdge:lastEdge));

        if numel(triangleGroup) > 1

            for j = 1:numel(triangleGroup)

                currentTriangle = triangleGroup(j);

                otherTriangles = ...
                    triangleGroup( ...
                    triangleGroup ~= currentTriangle);

                neighbors{currentTriangle} = [
                    neighbors{currentTriangle}, ...
                    otherTriangles'];
            end
        end

        firstEdge = lastEdge + 1;
    end
end


function hullIndices = removeCollinear( ...
    hullIndices,coordinates,lineTolerance)
% Remove mesh nodes located between the true rectangular corners.

    changed = true;

    while changed && numel(hullIndices) > 4

        changed = false;
        numberHullPoints = numel(hullIndices);

        for j = 1:numberHullPoints

            previousIndex = ...
                mod(j-2,numberHullPoints)+1;

            nextIndex = ...
                mod(j,numberHullPoints)+1;

            pointA = coordinates( ...
                hullIndices(previousIndex),:);

            pointB = coordinates( ...
                hullIndices(j),:);

            pointC = coordinates( ...
                hullIndices(nextIndex),:);

            lineAC = pointC-pointA;

            if norm(lineAC) == 0
                distance = norm(pointB-pointA);
            else
                distance = abs( ...
                    lineAC(1)*(pointA(2)-pointB(2)) - ...
                    lineAC(2)*(pointA(1)-pointB(1))) ...
                    /norm(lineAC);
            end

            if distance <= lineTolerance
                hullIndices(j) = [];
                changed = true;
                break
            end
        end
    end
end


function C = orderXY(C)
% Order:
%   1  larger x, larger y
%   2  larger x, smaller y
%   3  smaller x, larger y
%   4  smaller x, smaller y

    [~,xOrder] = sort(C(:,1),'descend');

    largerX = C(xOrder(1:2),:);
    smallerX = C(xOrder(3:4),:);

    [~,yOrder] = sort( ...
        largerX(:,2),'descend');

    largerX = largerX(yOrder,:);

    [~,yOrder] = sort( ...
        smallerX(:,2),'descend');

    smallerX = smallerX(yOrder,:);

    C = [largerX;smallerX];
end


function [V,F] = getMeshArrays(stlData)
% Accept a triangulation or an STL structure.

    if isa(stlData,'triangulation')
        V = stlData.Points;
        F = stlData.ConnectivityList;
        return
    end

    if ~isstruct(stlData)
        error(['Input must be an STL structure ', ...
               'or a triangulation object.']);
    end

    fieldNames = fieldnames(stlData);

    vertexField = find( ...
        strcmpi(fieldNames,'vertices'),1);

    faceField = find( ...
        strcmpi(fieldNames,'faces'),1);

    if isempty(vertexField) || isempty(faceField)
        error(['The input structure must contain ', ...
               'faces and vertices fields.']);
    end

    V = stlData.(fieldNames{vertexField});
    F = stlData.(fieldNames{faceField});
end
