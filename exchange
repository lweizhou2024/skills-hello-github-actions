@echo off
setlocal enabledelayedexpansion

set "LOGFILE=job.log"
set "MAXTRIES=40"
set "INTERVAL=1800"

for /L %%i in (1,1,%MAXTRIES%) do (

    if not exist "%LOGFILE%" (
        echo [Attempt %%i/%MAXTRIES%] %LOGFILE% not found yet.
    ) else (
        rem Get the last non-empty line of the file
        set "LASTLINE="
        for /f "usebackq delims=" %%L in ("%LOGFILE%") do (
            if not "%%L"=="" set "LASTLINE=%%L"
        )

        rem Extract the last word from that line
        set "LASTWORD="
        for %%W in (!LASTLINE!) do set "LASTWORD=%%W"

        echo [Attempt %%i/%MAXTRIES%] Last word: "!LASTWORD!"

        if "!LASTWORD!"=="COMPLETED" (
            echo Job completed. Running command...
            rem ==== put your command here ====
            call your_command.bat
            rem ================================
            goto :done
        )
    )

    if %%i lss %MAXTRIES% (
        echo Waiting %INTERVAL% seconds before next check...
        timeout /t %INTERVAL% /nobreak >nul
    )
)

echo Reached maximum number of attempts ^(%MAXTRIES%^) without seeing COMPLETED.
goto :eof

:done
echo Done.
endlocal
