function [corners,info] = extractTangCorners(stlData,angleDeg)
%EXTRACTTANGCORNERS Extract tang-end corners from an airfoil STL.
%
% [corners,info] = extractTangCorners(stlData)
% [corners,info] = extractTangCorners(stlData,angleDeg)
%
% The tang end cross section is assumed to have:
%   - one straight boundary edge on the larger-x side;
%   - one straight boundary edge on the smaller-x side;
%   - two curved boundaries following the airfoil shape.
%
% The four corners of each end face are defined as the endpoints of the
% two straight side edges.
%
% INPUT
% -----
% stlData:
%   Output from MATLAB's built-in stlread.
%
% angleDeg:
%   Maximum normal variation used when growing the end face.
%   Default = 8 degrees.
%
% OUTPUT ORDER
% ------------
% Higher-z tang end:
%   1  larger x, larger y
%   2  larger x, smaller y
%   3  smaller x, larger y
%   4  smaller x, smaller y
%
% Lower-z tang end:
%   5  larger x, larger y
%   6  larger x, smaller y
%   7  smaller x, larger y
%   8  smaller x, smaller y

    %% Read the STL data

    [V,F] = getMeshArrays(stlData);

    V = double(V);
    F = double(F);

    if size(V,2) ~= 3 || size(F,2) ~= 3
        error('Vertices and faces must each have three columns.');
    end

    if nargin < 2 || isempty(angleDeg)
        angleDeg = 8;
    end

    if angleDeg <= 0 || angleDeg >= 90
        error('angleDeg must be between 0 and 90 degrees.');
    end

    modelRange = max(V,[],1)-min(V,[],1);
    modelSize = norm(modelRange);

    if modelSize <= 0
        error('The STL model has zero size.');
    end

    coordinateTolerance = max(1e-12,1e-8*modelSize);

    %% Remove degenerate triangles and calculate triangle normals

    edge1 = V(F(:,2),:)-V(F(:,1),:);
    edge2 = V(F(:,3),:)-V(F(:,1),:);

    normalVector = cross(edge1,edge2,2);

    normalMagnitude = sqrt(sum(normalVector.^2,2));

    goodTriangle = ...
        normalMagnitude > max(coordinateTolerance^2,eps);

    F = F(goodTriangle,:);
    normalVector = normalVector(goodTriangle,:);
    normalMagnitude = normalMagnitude(goodTriangle);

    triangleNormals = ...
        normalVector./normalMagnitude(:,[1 1 1]);

    %% Find triangle neighbors

    neighbors = triangleNeighbors(F);

    %% Extract the high-z tang end

    [highCorners,highInfo] = growEndCap( ...
        V,F,triangleNormals,neighbors,+1, ...
        coordinateTolerance,modelSize,angleDeg);

    %% Extract the low-z tang end

    [lowCorners,lowInfo] = growEndCap( ...
        V,F,triangleNormals,neighbors,-1, ...
        coordinateTolerance,modelSize,angleDeg);

    %% Put corners in requested order

    highCorners = orderXY(highCorners);
    lowCorners = orderXY(lowCorners);

    corners = [
        highCorners
        lowCorners];

    %% Diagnostic output

    info.highEnd = highInfo;
    info.lowEnd = lowInfo;

    info.angleDeg = angleDeg;
    info.coordinateTolerance = coordinateTolerance;
end


function [cornerPoints,endInfo] = growEndCap( ...
    V,F,N,neighbors,zSign,coordinateTolerance,modelSize,angleDeg)
% Start from one global z extremity and grow its connected end face.

    %% Locate vertices at the requested z extremity

    if zSign > 0

        zExtreme = max(V(:,3));

        extremeVertexIDs = find( ...
            V(:,3) >= zExtreme-5*coordinateTolerance);

    else

        zExtreme = min(V(:,3));

        extremeVertexIDs = find( ...
            V(:,3) <= zExtreme+5*coordinateTolerance);
    end

    %% Find triangles touching the extreme vertices

    touchingTriangles = find( ...
        any(ismember(F,extremeVertexIDs),2));

    if isempty(touchingTriangles)
        error('No triangle was found at one z extremity.');
    end

    %% Choose the most z-facing triangle as the seed

    [largestNormalZ,index] = ...
        max(abs(N(touchingTriangles,3)));

    seedTriangle = touchingTriangles(index);

    if largestNormalZ < 0.10

        error(['The tang end appears nearly parallel to the ', ...
               'z stacking axis.']);
    end

    referenceNormal = N(seedTriangle,:);
    referencePoint = V(F(seedTriangle,1),:);

    %% Grow the connected end-face triangles

    cosineLimit = cos(angleDeg*pi/180);

    planeTolerance = max( ...
        50*coordinateTolerance, ...
        1e-4*modelSize);

    usedTriangle = false(size(F,1),1);
    usedTriangle(seedTriangle) = true;

    triangleQueue = seedTriangle;
    queuePosition = 1;

    while queuePosition <= numel(triangleQueue)

        currentTriangle = ...
            triangleQueue(queuePosition);

        queuePosition = queuePosition+1;

        adjacentTriangles = ...
            neighbors{currentTriangle};

        for j = 1:numel(adjacentTriangles)

            candidateTriangle = ...
                adjacentTriangles(j);

            if usedTriangle(candidateTriangle)
                continue
            end

            normalOK = abs(dot( ...
                N(candidateTriangle,:), ...
                referenceNormal)) >= cosineLimit;

            candidatePoints = ...
                V(F(candidateTriangle,:),:);

            planeDistance = abs( ...
                (candidatePoints-referencePoint)* ...
                referenceNormal');

            planeOK = ...
                max(planeDistance) <= planeTolerance;

            if normalOK && planeOK

                usedTriangle(candidateTriangle) = true;

                triangleQueue(end+1) = ...
                    candidateTriangle; %#ok<AGROW>
            end
        end
    end

    %% Extract the end-face boundary edges

    endTriangleIDs = find(usedTriangle);

    [boundaryEdges,boundaryVertexIDs] = ...
        findBoundaryEdges(F(endTriangleIDs,:));

    boundaryPoints = V(boundaryVertexIDs,:);

    if size(boundaryPoints,1) < 4

        error(['The detected end face has fewer than four ', ...
               'boundary vertices.']);
    end

    %% Detect the straight larger-x side

    [largeXEndpoints,largeXInfo] = ...
        findStraightSide( ...
        boundaryPoints,+1,modelSize);

    %% Detect the straight smaller-x side

    [smallXEndpoints,smallXInfo] = ...
        findStraightSide( ...
        boundaryPoints,-1,modelSize);

    %% Combine the four endpoints

    cornerPoints = [
        largeXEndpoints
        smallXEndpoints];

    %% Diagnostic output

    endInfo.seedTriangle = seedTriangle;
    endInfo.triangleIDs = endTriangleIDs;

    endInfo.boundaryEdges = boundaryEdges;
    endInfo.boundaryVertexIDs = boundaryVertexIDs;
    endInfo.boundaryPoints = boundaryPoints;

    endInfo.largeXSide = largeXInfo;
    endInfo.smallXSide = smallXInfo;

    endInfo.zExtreme = zExtreme;
    endInfo.referenceNormal = referenceNormal;
end


function [sideEndpoints,sideInfo] = ...
    findStraightSide(boundaryPoints,xSign,modelSize)
% Find one straight side of the end-face boundary.
%
% xSign = +1:
%   Search for the straight edge on the larger-x side.
%
% xSign = -1:
%   Search for the straight edge on the smaller-x side.

    x = boundaryPoints(:,1);

    minimumX = min(x);
    maximumX = max(x);

    xRange = maximumX-minimumX;

    if xRange <= eps
        error('The end-face boundary has zero x range.');
    end

    %% Restrict the search to the appropriate x-side region

    % A relatively wide band permits a slightly inclined straight side.

    sideBandFraction = 0.30;

    if xSign > 0

        candidateIndex = find( ...
            x >= maximumX-sideBandFraction*xRange);

    else

        candidateIndex = find( ...
            x <= minimumX+sideBandFraction*xRange);
    end

    candidatePoints = ...
        boundaryPoints(candidateIndex,:);

    if size(candidatePoints,1) < 2

        error(['Not enough boundary points were found on one ', ...
               'x side of the tang end.']);
    end

    %% Test lines through all candidate point pairs

    lineTolerance = max( ...
        1e-7*modelSize, ...
        1e-5*xRange);

    bestScore = -inf;
    bestPoint1 = [];
    bestPoint2 = [];
    bestInlier = [];
    bestDirection = [];

    numberCandidatePoints = ...
        size(candidatePoints,1);

    for j = 1:numberCandidatePoints-1

        for k = j+1:numberCandidatePoints

            point1 = candidatePoints(j,:);
            point2 = candidatePoints(k,:);

            lineDirection = point2-point1;
            lineLength = norm(lineDirection);

            if lineLength <= lineTolerance
                continue
            end

            unitDirection = ...
                lineDirection/lineLength;

            %% The side edge should run mainly in the y direction

            xyLength = norm(unitDirection(1:2));

            if xyLength <= eps
                continue
            end

            yDirectionFraction = ...
                abs(unitDirection(2))/xyLength;

            if yDirectionFraction < 0.50
                continue
            end

            %% Calculate distances from every boundary point to this line

            vectorFromLine = ...
                boundaryPoints-point1;

            projection = ...
                vectorFromLine*unitDirection';

            closestPoint = ...
                point1 + projection*unitDirection;

            lineDistance = sqrt(sum( ...
                (boundaryPoints-closestPoint).^2,2));

            inlier = ...
                lineDistance <= lineTolerance;

            if sum(inlier) < 2
                continue
            end

            inlierPoints = ...
                boundaryPoints(inlier,:);

            meanInlierX = ...
                mean(inlierPoints(:,1));

            %% Reject lines that are not on the requested outer side

            normalizedX = ...
                (meanInlierX-minimumX)/xRange;

            if xSign > 0

                outerPositionScore = normalizedX;

                if normalizedX < 0.60
                    continue
                end

            else

                outerPositionScore = 1-normalizedX;

                if normalizedX > 0.40
                    continue
                end
            end

            %% Measure the length covered by collinear inlier points

            inlierProjection = ...
                (inlierPoints-point1)*unitDirection';

            lineSpan = ...
                max(inlierProjection)-min(inlierProjection);

            numberInliers = sum(inlier);

            % Long straight lines on the appropriate outer side receive
            % the largest score. The inlier term favors a subdivided
            % straight edge over a chord through two curved-edge points.

            score = lineSpan* ...
                (1+0.10*max(numberInliers-2,0))* ...
                (0.5+outerPositionScore);

            if score > bestScore

                bestScore = score;
                bestPoint1 = point1;
                bestPoint2 = point2;
                bestInlier = inlier;
                bestDirection = unitDirection;
            end
        end
    end

    if isempty(bestPoint1)

        error(['A straight boundary edge could not be found on ', ...
               'one x side of the tang end.']);
    end

    %% Use the endpoints of the fitted straight-line run

    straightPoints = ...
        boundaryPoints(bestInlier,:);

    straightProjection = ...
        (straightPoints-bestPoint1)*bestDirection';

    [~,minimumIndex] = min(straightProjection);
    [~,maximumIndex] = max(straightProjection);

    endpoint1 = straightPoints(minimumIndex,:);
    endpoint2 = straightPoints(maximumIndex,:);

    %% Put larger-y endpoint first

    if endpoint1(2) >= endpoint2(2)

        sideEndpoints = [
            endpoint1
            endpoint2];

    else

        sideEndpoints = [
            endpoint2
            endpoint1];
    end

    %% Diagnostic output

    sideInfo.endpoints = sideEndpoints;
    sideInfo.inlierPoints = straightPoints;
    sideInfo.direction = bestDirection;
    sideInfo.score = bestScore;
    sideInfo.lineTolerance = lineTolerance;
    sideInfo.initialPoint1 = bestPoint1;
    sideInfo.initialPoint2 = bestPoint2;
end


function [boundaryEdges,boundaryVertexIDs] = ...
    findBoundaryEdges(endFaces)
% Find edges used by exactly one triangle within the selected end face.

    allEdges = [
        sort(endFaces(:,[1 2]),2)
        sort(endFaces(:,[2 3]),2)
        sort(endFaces(:,[3 1]),2)];

    [uniqueEdges,~,edgeMap] = ...
        unique(allEdges,'rows');

    edgeCount = accumarray(edgeMap,1);

    boundaryEdges = ...
        uniqueEdges(edgeCount == 1,:);

    boundaryVertexIDs = ...
        unique(boundaryEdges(:));
end


function neighbors = triangleNeighbors(F)
% Find triangles that share a complete edge.

    numberTriangles = size(F,1);

    edges = [
        sort(F(:,[1 2]),2)
        sort(F(:,[2 3]),2)
        sort(F(:,[3 1]),2)];

    triangleID = repmat( ...
        (1:numberTriangles)',3,1);

    [edges,sortingIndex] = ...
        sortrows(edges,[1 2]);

    triangleID = ...
        triangleID(sortingIndex);

    neighbors = ...
        cell(numberTriangles,1);

    firstEdge = 1;

    while firstEdge <= size(edges,1)

        lastEdge = firstEdge;

        while lastEdge < size(edges,1) && ...
                all(edges(lastEdge+1,:) == edges(firstEdge,:))

            lastEdge = lastEdge+1;
        end

        trianglesUsingEdge = unique( ...
            triangleID(firstEdge:lastEdge));

        if numel(trianglesUsingEdge) > 1

            for j = 1:numel(trianglesUsingEdge)

                currentTriangle = ...
                    trianglesUsingEdge(j);

                otherTriangles = ...
                    trianglesUsingEdge( ...
                    trianglesUsingEdge ~= currentTriangle);

                neighbors{currentTriangle} = [
                    neighbors{currentTriangle}, ...
                    otherTriangles'];
            end
        end

        firstEdge = lastEdge+1;
    end
end


function orderedCorners = orderXY(cornerPoints)
% Order corners according to global x and y coordinates.

    if size(cornerPoints,1) ~= 4
        error('Exactly four corner points are required.');
    end

    [~,xOrder] = ...
        sort(cornerPoints(:,1),'descend');

    largerXPoints = ...
        cornerPoints(xOrder(1:2),:);

    smallerXPoints = ...
        cornerPoints(xOrder(3:4),:);

    [~,yOrder] = ...
        sort(largerXPoints(:,2),'descend');

    largerXPoints = ...
        largerXPoints(yOrder,:);

    [~,yOrder] = ...
        sort(smallerXPoints(:,2),'descend');

    smallerXPoints = ...
        smallerXPoints(yOrder,:);

    orderedCorners = [
        largerXPoints
        smallerXPoints];
end


function [V,F] = getMeshArrays(stlData)
% Read mesh arrays from MATLAB's built-in stlread output.

    if isa(stlData,'triangulation')

        V = stlData.Points;
        F = stlData.ConnectivityList;

        return
    end

    if ~isstruct(stlData)

        error(['Input must be a triangulation object or a ', ...
               'structure containing faces and vertices.']);
    end

    fieldNames = fieldnames(stlData);

    vertexField = find( ...
        strcmpi(fieldNames,'vertices'),1);

    faceField = find( ...
        strcmpi(fieldNames,'faces'),1);

    if isempty(vertexField) || isempty(faceField)

        error(['The structure must contain fields named ', ...
               'vertices and faces.']);
    end

    V = stlData.(fieldNames{vertexField});
    F = stlData.(fieldNames{faceField});
end
