@echo off
setlocal enabledelayedexpansion

set "LOGFILE=job.log"
set "TARGET=COMPLETED"

set "LASTLINE="
for /f "usebackq delims=" %%L in ("%LOGFILE%") do (
    if not "%%L"=="" set "LASTLINE=%%L"
)

set "LASTWORD="
for %%W in (!LASTLINE!) do set "LASTWORD=%%W"

echo Last word: "!LASTWORD!"

if "!LASTWORD!"=="%TARGET%" (
    echo MATCH
) else (
    echo NO MATCH
)

endlocal
